# D1 is bound via wrangler.jsonc (`DB`). No database URL for local or production.

# Local only — skip Cloudflare Access so you can edit. Do not set in production.
AUTH_DEV_BYPASS=1

# Production (wrangler secret put …): 30-day editor session after Access login.
# SESSION_SECRET=  # openssl rand -base64 32  (32+ characters)
# CF_ACCESS_TEAM_DOMAIN=https://YOURTEAM.cloudflareaccess.com
# CF_ACCESS_AUD=  # Access application AUD tag for /login
# Optional: only this email may establish a session
# CF_ACCESS_EMAIL=you@example.com

# Optional: default lat/lon for weather when a run has no GPS route (Open-Meteo, no API key).
# Falls back to the centroid of any stored route, then 52.35 / 5.63 (NL).
# DEFAULT_LAT=52.35
# DEFAULT_LON=5.63
