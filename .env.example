# D1 is bound via wrangler.jsonc (`DB`). No connection string for local/prod app traffic.

# Optional: only for the one-shot Neon → D1 dump (not read by the Worker).
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/thelongrun?sslmode=require

# Optional: only for the dump script, if your data lives outside ./data
# DATA_DIR=/absolute/path/to/data

# Optional: default lat/lon for weather when a run has no GPS route (Open-Meteo, no API key).
# Falls back to the centroid of any stored route, then 52.35 / 5.63 (NL).
# DEFAULT_LAT=52.35
# DEFAULT_LON=5.63
