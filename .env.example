# Neon Postgres — REQUIRED. Use the *pooled* connection string (host contains `-pooler`).
# Local dev + `npm run migrate` read this from .env; on Cloudflare Pages set it as an
# environment variable / secret in the project settings.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/thelongrun?sslmode=require

# Optional: only for the migration script, if your data lives outside ./data
# DATA_DIR=/absolute/path/to/data

# Optional: default lat/lon for weather when a run has no GPS route (Open-Meteo, no API key).
# Falls back to the centroid of any stored route, then 52.35 / 5.63 (NL).
# DEFAULT_LAT=52.35
# DEFAULT_LON=5.63
