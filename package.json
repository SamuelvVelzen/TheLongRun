{
	"name": "the-long-run",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"backfill-weather": "node scripts/backfill-weather.mjs",
		"backfill-strava-metrics": "node scripts/backfill-strava-metrics.mjs",
		"backfill-splits": "node scripts/backfill-splits.mjs",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"fit-file-parser": "^4.1.0",
		"gray-matter": "^4.0.3",
		"jszip": "^3.10.1",
		"marked": "^18.0.7"
	}
}
