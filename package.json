{
	"name": "the-long-run",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"login": "wrangler login",
		"d1:apply:local": "wrangler d1 migrations apply thelongrun --local",
		"d1:apply:remote": "wrangler d1 migrations apply thelongrun --remote",
		"d1:export": "wrangler d1 export thelongrun --remote --output=.wrangler/d1-backup.sql",
		"d1:import:local": "node scripts/d1-import-local.cjs",
		"d1:pull": "npm run d1:export && npm run d1:import:local",
		"d1:exec:local": "wrangler d1 execute thelongrun --local",
		"d1:exec:remote": "wrangler d1 execute thelongrun --remote",
		"d1:counts:local": "wrangler d1 execute thelongrun --local --command=\"SELECT (SELECT COUNT(*) FROM runs) AS runs, (SELECT COUNT(*) FROM routes) AS routes, (SELECT COUNT(*) FROM planned_routes) AS planned, (SELECT COUNT(*) FROM context) AS context\"",
		"d1:counts:remote": "wrangler d1 execute thelongrun --remote --command=\"SELECT (SELECT COUNT(*) FROM runs) AS runs, (SELECT COUNT(*) FROM routes) AS routes, (SELECT COUNT(*) FROM planned_routes) AS planned, (SELECT COUNT(*) FROM context) AS context\"",
		"lint": "prettier --check . && eslint . && npm run check",
		"lint:ci": "npm run check && npm run lint:eslint",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.50.0",
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"globals": "^17.13.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.0.16",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.35",
		"countries-and-timezones": "^3.10.0",
		"jose": "^6.2.10",
		"marked": "^18.0.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"tz-lookup": "^6.1.25",
		"zod": "^4.6.5"
	}
}
